<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.horse_racing.controller.RaceViewController"
      spacing="20" style="-fx-padding: 24;" minWidth="500" maxWidth="Infinity" maxHeight="Infinity">
    <Label text="Simulate Race" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0d4a2e;"/>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button fx:id="saveButton" text="Save to File" onAction="#saveToFile" styleClass="btn-secondary"/>
        <Button fx:id="selectButton" text="Select Horses" onAction="#selectHorses" styleClass="btn-primary"/>
        <Button fx:id="restartButton" text="Restart" onAction="#restartRace" styleClass="btn-secondary"/>
    </HBox>
    <VBox fx:id="selectedHorsesBox" spacing="10" visible="false" style="-fx-background-color: #fdfcf9; -fx-background-radius: 10; -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(13,74,46,0.06), 8, 0, 0, 1);">
        <Label text="Selected for Race" style="-fx-font-weight: bold; -fx-text-fill: #0d4a2e;"/>
        <HBox fx:id="selectedHorsesDisplay" spacing="16"/>
    </VBox>
    <VBox fx:id="raceTrackBox" spacing="10" visible="false" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="16">
            <Label text="Race Track" style="-fx-font-weight: bold; -fx-text-fill: #0d4a2e;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="timerLabel" text="0.0s" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #d4a84b;"/>
        </HBox>
        <Pane fx:id="raceTrackPane" VBox.vgrow="ALWAYS" minHeight="200" prefHeight="220" minWidth="500" prefWidth="900" maxWidth="Infinity" maxHeight="Infinity"
              style="-fx-background-color: linear-gradient(to bottom, #6B4423 0%, #8B6914 20%, #A67B5B 40%, #C19A6B 50%, #A67B5B 60%, #8B6914 80%, #5C4033 100%); -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 14, 0, 0, 4); -fx-border-color: #4A3520; -fx-border-width: 2; -fx-border-radius: 10;"/>
    </VBox>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button fx:id="simulateButton" text="▶ Simulate Race" onAction="#startSimulation" styleClass="btn-accent"
                style="-fx-padding: 12 28; -fx-font-size: 14px;" visible="false"/>
        <Button fx:id="resultsButton" text="Results" onAction="#showResults" styleClass="btn-secondary"
                style="-fx-padding: 12 28; -fx-font-size: 14px;" visible="false" disable="true"/>
        <Button fx:id="viewChartButton" text="📊 View Chart" onAction="#viewChart" styleClass="btn-secondary"
                style="-fx-padding: 12 28; -fx-font-size: 14px;" visible="false" disable="true"/>
    </HBox>
</VBox>
