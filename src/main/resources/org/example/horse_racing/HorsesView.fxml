<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.horse_racing.controller.HorsesViewController"
      spacing="20" style="-fx-padding: 24;">
    <HBox alignment="CENTER_LEFT" spacing="16">
        <Label text="View Horses" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0d4a2e;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <ToggleButton fx:id="viewTableBtn" text="Table" styleClass="toggle-btn"/>
        <ToggleButton fx:id="viewBoxBtn" text="Cards" styleClass="toggle-btn"/>
        <Button fx:id="addButton" text="+ Add Horse" onAction="#openAddDialog" styleClass="btn-accent"
                style="-fx-padding: 10 20; -fx-background-radius: 8;"/>
    </HBox>
    <StackPane fx:id="contentPane" VBox.vgrow="ALWAYS" style="-fx-background-color: #fdfcf9; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(13,74,46,0.06), 10, 0, 0, 2);">
        <ScrollPane fx:id="tablePane" fitToWidth="true" fitToHeight="true" style="-fx-background: transparent;">
            <TableView fx:id="horseTableView" styleClass="table-view" style="-fx-background-color: white; -fx-table-cell-border-color: transparent;"/>
        </ScrollPane>
        <ScrollPane fx:id="cardsPane" fitToWidth="true" fitToHeight="true" visible="false" style="-fx-background: #f8f6f0;">
            <GridPane fx:id="horseCardsPane" hgap="16" vgap="16" style="-fx-padding: 20;"/>
        </ScrollPane>
    </StackPane>
</VBox>
