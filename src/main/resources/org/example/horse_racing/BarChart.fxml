<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Pane?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.horse_racing.controller.BarChartController"
           minWidth="400" minHeight="300" maxWidth="Infinity" maxHeight="Infinity"
           style="-fx-padding: 20; -fx-background-color: #fdfcf9; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(13,74,46,0.08), 12, 0, 0, 2);">
    <BarChart fx:id="barChart" title="Race Time (seconds)"
              style="-fx-background-color: transparent; -fx-background-radius: 8;"
              legendVisible="false"
              minWidth="300" minHeight="250" maxWidth="Infinity" maxHeight="Infinity">
        <xAxis>
            <CategoryAxis side="BOTTOM" label="Horse"/>
        </xAxis>
        <yAxis>
            <NumberAxis fx:id="yAxis" side="LEFT" label="Time (seconds)"/>
        </yAxis>
    </BarChart>
    <Pane fx:id="chartOverlay" mouseTransparent="true" pickOnBounds="false"
          maxWidth="Infinity" maxHeight="Infinity"/>
</StackPane>
