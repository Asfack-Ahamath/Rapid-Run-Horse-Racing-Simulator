<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.horse_racing.controller.DashboardController"
      maxWidth="Infinity" maxHeight="Infinity" spacing="0"
      style="-fx-background-color: #faf9f7;">
    <!-- Hero Banner -->
    <VBox alignment="CENTER_LEFT" spacing="4" maxWidth="Infinity"
          style="-fx-background-color: linear-gradient(to right, #0d4a2e 0%, #1a6b4a 50%, #0d4a2e 100%); -fx-padding: 28 32;">
        <HBox alignment="CENTER_LEFT" spacing="16">
            <Label text="Welcome back" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label fx:id="statRaceReady" text="Checking..." style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 6 14; -fx-background-radius: 20;"/>
        </HBox>
        <Label text="Your stable at a glance" style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.85);"/>
    </VBox>

    <!-- Content -->
    <VBox spacing="24" VBox.vgrow="ALWAYS"
          style="-fx-padding: 28 32 36 32;">
        <!-- Stats Row -->
        <HBox spacing="18" alignment="CENTER_LEFT" maxWidth="Infinity">
            <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="4" maxWidth="Infinity"
                  style="-fx-min-width: 80; -fx-pref-height: 100; -fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(13,74,46,0.15), 12, 0, 0, 4); -fx-border-color: #0d4a2e; -fx-border-width: 2; -fx-border-radius: 12;">
                <Label fx:id="statTotal" text="0" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #0d4a2e;"/>
                <Label text="Total Horses" style="-fx-font-size: 12px; -fx-text-fill: #5a6c5a;"/>
            </VBox>
            <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="4" maxWidth="Infinity"
                  style="-fx-min-width: 80; -fx-pref-height: 100; -fx-background-color: linear-gradient(to bottom right, #fff9e6 0%, #ffe8a0 100%); -fx-background-radius: 12; -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(212,168,75,0.25), 10, 0, 0, 3);">
                <Label fx:id="statGroupA" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #8a6914;"/>
                <Label text="Group A" style="-fx-font-size: 11px; -fx-text-fill: #6b5d4b;"/>
            </VBox>
            <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="4" maxWidth="Infinity"
                  style="-fx-min-width: 80; -fx-pref-height: 100; -fx-background-color: linear-gradient(to bottom right, #e8f4fc 0%, #add8f7 100%); -fx-background-radius: 12; -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(42,107,181,0.2), 10, 0, 0, 3);">
                <Label fx:id="statGroupB" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1e5a8e;"/>
                <Label text="Group B" style="-fx-font-size: 11px; -fx-text-fill: #4a6b8a;"/>
            </VBox>
            <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="4" maxWidth="Infinity"
                  style="-fx-min-width: 80; -fx-pref-height: 100; -fx-background-color: linear-gradient(to bottom right, #fce8e8 0%, #f0b0b0 100%); -fx-background-radius: 12; -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(196,69,54,0.2), 10, 0, 0, 3);">
                <Label fx:id="statGroupC" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #8b2c2c;"/>
                <Label text="Group C" style="-fx-font-size: 11px; -fx-text-fill: #6b4a4a;"/>
            </VBox>
            <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="4" maxWidth="Infinity"
                  style="-fx-min-width: 80; -fx-pref-height: 100; -fx-background-color: linear-gradient(to bottom right, #e6f5ec 0%, #7ed9a8 100%); -fx-background-radius: 12; -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(45,143,94,0.2), 10, 0, 0, 3);">
                <Label fx:id="statGroupD" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1a6b3d;"/>
                <Label text="Group D" style="-fx-font-size: 11px; -fx-text-fill: #4a6b5a;"/>
            </VBox>
        </HBox>

        <!-- Main content row -->
        <HBox spacing="24" HBox.hgrow="ALWAYS">
            <!-- Left: Race Status -->
            <VBox HBox.hgrow="ALWAYS" spacing="12" alignment="TOP_LEFT"
                  style="-fx-pref-width: 340; -fx-background-color: white; -fx-background-radius: 14; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 14, 0, 0, 4);">
                <Label text="Race Status" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0d4a2e;"/>
                <Label fx:id="statRaceReadyDetail" text="Each group needs at least one horse." wrapText="true" style="-fx-font-size: 13px; -fx-text-fill: #4a5568; -fx-line-spacing: 6;"/>
            </VBox>

            <!-- Right: Quick Start -->
            <VBox HBox.hgrow="ALWAYS" spacing="16" alignment="TOP_LEFT"
                  style="-fx-pref-width: 340; -fx-background-color: white; -fx-background-radius: 14; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 14, 0, 0, 4);">
                <Label text="How to run a race" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0d4a2e;"/>
                <VBox spacing="12">
                    <HBox spacing="14" alignment="CENTER_LEFT">
                        <Label text="1" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: #0d4a2e; -fx-background-radius: 14; -fx-padding: 6 12; -fx-min-width: 28; -fx-alignment: center;"/>
                        <Label text="Save to File in Simulate Race" style="-fx-font-size: 13px; -fx-text-fill: #2d3748;"/>
                    </HBox>
                    <HBox spacing="14" alignment="CENTER_LEFT">
                        <Label text="2" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: #0d4a2e; -fx-background-radius: 14; -fx-padding: 6 12; -fx-min-width: 28; -fx-alignment: center;"/>
                        <Label text="Select Horses (one per group)" style="-fx-font-size: 13px; -fx-text-fill: #2d3748;"/>
                    </HBox>
                    <HBox spacing="14" alignment="CENTER_LEFT">
                        <Label text="3" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: #0d4a2e; -fx-background-radius: 14; -fx-padding: 6 12; -fx-min-width: 28; -fx-alignment: center;"/>
                        <Label text="Simulate Race and view results" style="-fx-font-size: 13px; -fx-text-fill: #2d3748;"/>
                    </HBox>
                </VBox>
            </VBox>
        </HBox>

        <!-- Bottom: Quick actions -->
        <HBox spacing="20" alignment="CENTER_LEFT" maxWidth="Infinity">
            <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="6" maxWidth="Infinity"
                  style="-fx-min-width: 120; -fx-pref-height: 90; -fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8, 0, 0, 2);">
                <Label text="View Horses" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #0d4a2e;"/>
                <Label text="Manage your stable" style="-fx-font-size: 11px; -fx-text-fill: #718096;"/>
            </VBox>
            <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="6" maxWidth="Infinity"
                  style="-fx-min-width: 120; -fx-pref-height: 90; -fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8, 0, 0, 2);">
                <Label text="Simulate Race" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #0d4a2e;"/>
                <Label text="Run animated races" style="-fx-font-size: 11px; -fx-text-fill: #718096;"/>
            </VBox>
            <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="6" maxWidth="Infinity"
                  style="-fx-min-width: 120; -fx-pref-height: 90; -fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8, 0, 0, 2);">
                <Label text="Export Data" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #0d4a2e;"/>
                <Label text="Save to file" style="-fx-font-size: 11px; -fx-text-fill: #718096;"/>
            </VBox>
        </HBox>
    </VBox>
</VBox>
